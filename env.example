# ShieldAI environment variables
# Copy to .env for local development. NEVER commit .env — only this file.
# In production these are set in Railway → Variables, not in any file.

# ── Required ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
JWT_SECRET=

# ── AI providers (optional — fallback chain) ──────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=

# ── Threat intelligence ───────────────────────────────────────
# Required for breach monitoring. Without it: "Not active" (never a fake all-clear).
HIBP_API_KEY=
HIBP_USER_AGENT=ShieldAI-vCISO
# Optional. Without it, CVE refreshes take ~78s instead of ~8s. Free key:
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── Demo sandbox ──────────────────────────────────────────────
# MUST differ from JWT_SECRET, or demo tokens could be verified as production
# tokens and the sandbox isolation would collapse.
DEMO_JWT_SECRET=
SEED_DEMO_ON_BOOT=false
SEED_DEMO_FORCE=false

# ── Billing (built but OFF — see BILLING_SETUP.md) ─────────────
# Nothing below does anything until BILLING_ENABLED=true. Use TEST keys first.
# A live key is refused unless BILLING_ALLOW_LIVE=true is ALSO set.
BILLING_ENABLED=
BILLING_ALLOW_LIVE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The publishable key (pk_...) is not used by this backend (Checkout, the portal
# and invoices are all Stripe-hosted). Only add it if a future feature needs Stripe.js.
# STRIPE_PUBLISHABLE_KEY=
# Printed by `npm run stripe:setup` (override the ids in tiers.js):
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_GUIDED=
STRIPE_PRICE_TRAINING_DELIVERY=
STRIPE_PRICE_COMPLIANCE_FRAMEWORK=
# Optional feature flags (each defaults OFF; each needs dashboard setup first):
BILLING_ACH=                       # bank payments (us_bank_account via Financial Connections)
BILLING_AUTOMATIC_TAX=             # Stripe Tax (needs a tax registration configured)
BILLING_PROMO_CODES=
BILLING_PAST_DUE_GRACE_DAYS=7      # shown to clients as the "fix your payment by" date
BILLING_INVOICE_DAYS_UNTIL_DUE=14  # framework add-on invoices

# ── Directory integrations (optional — connect fails without these) ─
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=

# ── Config (not secrets) ──────────────────────────────────────
ADMIN_EMAIL=
ANALYST_EMAIL=
APP_URL=
# Comma-separated extra allowed origins for the CORS allowlist (e.g. a custom
# domain once one is added). Railway's URL and localhost dev are always allowed.
CORS_ORIGIN=
PORT=3001
# Must point at the mounted volume in production (Railway: /data)
DB_DIR=
