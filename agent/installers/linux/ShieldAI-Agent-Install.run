#!/usr/bin/env bash
# ============================================================================
#  ShieldAI Agent — Linux Installer (self-extracting)
# ----------------------------------------------------------------------------
#  Single-file installer: chmod +x, then run it (as root/sudo). No separate
#  download of scripts, no folder to keep together — everything needed is
#  packed into this one file.
#
#    sudo ./ShieldAI-Agent-Install.run
#
#  It prompts for the enrollment token, then runs the existing linux/install.sh
#  unchanged — same systemd service + timer, same config.json, same behavior
#  as the manual process in INSTALL_CHECKLIST.md.
# ============================================================================
set -euo pipefail

DEFAULT_SERVER_URL="https://shieldai-production-627e.up.railway.app"
SERVER_URL="$DEFAULT_SERVER_URL"
INTERVAL_MINUTES=60
ENROLLMENT_TOKEN=""

# Advanced/testing overrides — clients never need these:
#   ./ShieldAI-Agent-Install.run --server-url http://localhost:3001
#   ./ShieldAI-Agent-Install.run --enrollment-token XXXX   (skip the prompt)
while [ $# -gt 0 ]; do
  case "$1" in
    --server-url) SERVER_URL="$2"; shift 2 ;;
    --enrollment-token) ENROLLMENT_TOKEN="$2"; shift 2 ;;
    --interval-minutes) INTERVAL_MINUTES="$2"; shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

if [ "$(id -u)" -ne 0 ]; then
  echo "This installer needs root to register the agent as a system service."
  echo "Re-run as:  sudo ./ShieldAI-Agent-Install.run"
  exit 1
fi

if ! command -v systemctl >/dev/null 2>&1; then
  echo "systemd (systemctl) is required and wasn't found on this machine." >&2
  exit 1
fi

echo "==============================================="
echo " ShieldAI Agent — Linux Installer"
echo "==============================================="
echo

if [ -z "$ENROLLMENT_TOKEN" ]; then
  echo "In your ShieldAI dashboard: Endpoints -> Add Endpoint, then copy the"
  echo "enrollment token it generates (valid ~60 minutes, single use)."
  echo
  read -r -p "Paste enrollment token: " ENROLLMENT_TOKEN
  while [ -z "$ENROLLMENT_TOKEN" ]; do
    read -r -p "Token can't be empty. Paste enrollment token: " ENROLLMENT_TOKEN
  done
fi

WORKDIR="$(mktemp -d /tmp/shieldai-install.XXXXXX)"
cleanup() { rm -rf "$WORKDIR"; }
trap cleanup EXIT

# Everything after the __PAYLOAD_BELOW__ marker line is a base64-encoded
# tar.gz of the agent/ folder (linux/install.sh, linux/collect.sh,
# shared/agent-run.sh). Extract it to a temp dir and run the real installer.
ARCHIVE_LINE=$(awk '/^__PAYLOAD_BELOW__$/ {print NR + 1; exit}' "$0")
tail -n "+$ARCHIVE_LINE" "$0" | base64 -d | tar xz -C "$WORKDIR"

echo
echo "Installing..."
bash "$WORKDIR/agent/linux/install.sh" \
  --server-url "$SERVER_URL" \
  --enrollment-token "$ENROLLMENT_TOKEN" \
  --interval-minutes "$INTERVAL_MINUTES"

echo
echo "Verify any time with: systemctl status shieldai-agent.timer"
exit 0

__PAYLOAD_BELOW__

